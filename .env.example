# KrishiVeda env template - copy to .env
ENVIRONMENT=development
DEBUG=True
DATABASE_URL=sqlite+aiosqlite:///./krishiveda.db
SECRET_KEY=change-me-in-production

# HuggingFace Inference API (for chatbot + RAG). Get free token: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=
# Optional: override default Mistral model
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ElevenLabs for TTS/STT (voice-first). Get free key: https://elevenlabs.io/api-keys
# Falls back to edge-tts / gTTS / browser speechSynthesis when absent.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# Embeddings for RAG
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend origin
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]
